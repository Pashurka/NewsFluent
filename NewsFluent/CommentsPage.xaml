<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewsFluent.CommentsPage"
             Title="Коментарі та відгуки"
             BackgroundColor="#f4f4f4">

    <ContentPage.Resources>
        <Style TargetType="Frame">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HasShadow" Value="True"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20">
        <Label 
            Text="Останні відгуки користувачів"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,10"
            TextColor="#222" />

        <!-- CollectionView для відгуків -->
        <CollectionView x:Name="CommentsCollectionView" ItemsLayout="VerticalGrid, 2" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame>
                        <VerticalStackLayout>
                            <Label Text="{Binding UserInfo}" FontSize="12" TextColor="#777" />
                            <Label Text="{Binding NewsSummary}" FontAttributes="Bold" FontSize="13" />
                            <Label Text="{Binding UserComment}" FontSize="13" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
