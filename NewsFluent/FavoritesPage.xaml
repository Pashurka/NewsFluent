<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewsFluent.FavoritesPage"
             Title="Улюблені новини"
             BackgroundColor="#f4f4f4">

    <ContentPage.Resources>
        <Style TargetType="Frame">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HasShadow" Value="True"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20">
        <Image
                Source="logo.png"
                HeightRequest="85"
                Aspect="AspectFit"
                SemanticProperties.Description="Logo NewsFluent" />
        
        <!-- CollectionView для улюблених новин -->
        <CollectionView x:Name="FavoritesCollectionView" ItemsLayout="VerticalGrid, 2" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame>
                        <VerticalStackLayout>
                            <Label Text="{Binding NewsTitle}" FontSize="13" FontAttributes="Bold" />
                            <Label Text="{Binding NewsSummary}" FontSize="12" TextColor="#777" />
                            <Label Text="{Binding DateTime}" FontSize="10" TextColor="#444" />

                            <!-- Мій коментар -->
                            <Label Text="Мій коментар" FontSize="12" FontAttributes="Italic" TextColor="#0066cc" />
                            <Label Text="{Binding UserComment}" FontSize="12" TextColor="#555" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
