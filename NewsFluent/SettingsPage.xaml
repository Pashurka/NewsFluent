<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewsFluent.SettingsPage"
             Title="Налаштування застосунку"
             BackgroundColor="#f4f4f4">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Налаштування" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />

            <Frame>
                <VerticalStackLayout>
                    <Label Text="Мова інтерфейсу" FontSize="16" />
                    <Picker>
                        <Picker.Items>
                            <x:String>Українська</x:String>
                            <x:String>English</x:String>
                            <x:String>Deutsch</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Frame>

            <Frame>
                <VerticalStackLayout>
                    <Label Text="Тема оформлення" FontSize="16" />
                    <Picker>
                        <Picker.Items>
                            <x:String>Світла</x:String>
                            <x:String>Темна</x:String>
                            <x:String>Системна</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Frame>

            <Frame>
                <VerticalStackLayout>
                    <Label Text="Категорії новин" FontSize="16" />
                    <CheckBox IsChecked="True" />
                    <Label Text="Технології" />
                    <CheckBox />
                    <Label Text="Політика" />
                    <CheckBox />
                    <Label Text="Спорт" />
                    <CheckBox />
                    <Label Text="Культура" />
                </VerticalStackLayout>
            </Frame>

            <Frame>
                <VerticalStackLayout>
                    <Label Text="Сповіщення" FontSize="16" />
                    <Switch IsToggled="True" />
                    <Label Text="Отримувати сповіщення про новини" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Зберегти налаштування" BackgroundColor="#007AFF" TextColor="White" CornerRadius="10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
